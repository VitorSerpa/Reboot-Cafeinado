PORT=3333
NODE_ENV=development
# Origens permitidas pelo CORS (HTTP e WebSocket), separadas por vírgula
CORS_ORIGIN=http://localhost:3000
# Assina a sessão do login (cookie e token da aba, na API e no WebSocket). Qualquer texto longo e aleatório.
SESSION_SECRET=troque-este-segredo
# O conector de API fica em /hub/v1 nesta mesma porta. Os tokens dele ficam no banco: npm run gerar-token -- aurora

# Banco. Vazio = Postgres embutido (PGlite) em PGLITE_DIR, só nesta máquina: o Hub não alcança.
# Supabase (o Hub lê o contexto pelo conector PostgreSQL): no projeto, Connect → "Session pooler" → copie a URI
# e troque [YOUR-PASSWORD] pela senha do banco. Na senha, @ vira %40, # vira %23, / vira %2F.
#   DATABASE_URL=postgresql://postgres.<ref>:<senha>@<host do pooler>.pooler.supabase.com:5432/postgres
# Não use a conexão direta (db.<ref>.supabase.co): no plano gratuito ela é só IPv6.
DATABASE_URL=
# Opcional: certificado do Supabase (Database Settings → SSL Configuration → Download certificate).
# Com ele, o app verifica o servidor; sem ele, a conexão é cifrada mas o certificado não é verificado.
DATABASE_SSL_CA=
PGLITE_DIR=

# Kaffa AI Hub
# HUB_MODE: "real" chama o agente; "simulado" usa respostas fixas (sem chave, sem custo).
# Vazio = "real" se HUB_API_KEY estiver preenchida, senão "simulado".
HUB_MODE=
HUB_BASE_URL=https://belatrix.ai
HUB_API_KEY=
HUB_AGENTE_AURORA=06abc3a3-1c9f-785e-8000-519434bce89a
HUB_TIMEOUT_MS=90000
